const PlayerService = game:GetService("Players")
const RunService = game:GetService("RunService")

const Trove = loadstring(game:HttpGet("https://raw.githubusercontent.com/Sleitnick/RbxUtil/refs/heads/main/modules/trove/init.luau"))()

const LocalPlayer = PlayerService.LocalPlayer
const Camera = workspace.CurrentCamera

local ViewESPDistance = 2500

local EnemyBoxESP = true
local EnemyNameESP = true
local EnemyHealthBarESP = true
local EnemyTracerESP = false

local TeamBoxESP = false
local TeamNameESP = false
local TeamHealthBarESP = false
local TeamTracerESP = false

local SelfBoxESP = false
local SelfNameESP = false
local SelfHealthBarESP = false
local SelfTracerESP = false

const EnemyESPColour = Color3.fromRGB(255, 50, 50)
const FriendlyESPColour = Color3.fromRGB(50, 255, 50)
const NeutralESPColour = Color3.fromRGB(65, 204, 255)

const HighHP = Color3.fromRGB(0, 255, 0)
const MediumHP = Color3.fromRGB(255, 255, 0)
const LowHP = Color3.fromRGB(255, 0, 0)

const ESP = {}

local Running = false

local MainTrove = Trove.new()
local PlayerTroves = {}
local ESPObjects = {}

function ESP:_isSelf(player: Player)
	return player == LocalPlayer
end

function ESP:_isTeammate(player: Player)
	if player == LocalPlayer then
		return false
	end

	if not LocalPlayer.Team or not player.Team then
		return false
	end

	return player.Team == LocalPlayer.Team
end

function ESP:_isEnemy(player: Player)
	if player == LocalPlayer then
		return false
	end

	if not LocalPlayer.Team or not player.Team then
		return true
	end

	return player.Team ~= LocalPlayer.Team
end

function ESP:_shouldShowBox(player: Player)
	if ESP:_isSelf(player) then
		return SelfBoxESP
	end

	if ESP:_isTeammate(player) then
		return TeamBoxESP
	end

	return EnemyBoxESP
end

function ESP:_shouldShowName(player: Player)
	if ESP:_isSelf(player) then
		return SelfNameESP
	end

	if ESP:_isTeammate(player) then
		return TeamNameESP
	end

	return EnemyNameESP
end

function ESP:_shouldShowHealthBar(player: Player)
	if ESP:_isSelf(player) then
		return SelfHealthBarESP
	end

	if ESP:_isTeammate(player) then
		return TeamHealthBarESP
	end

	return EnemyHealthBarESP
end

function ESP:_shouldShowTracer(player: Player)
	if ESP:_isSelf(player) then
		return SelfTracerESP
	end

	if ESP:_isTeammate(player) then
		return TeamTracerESP
	end

	return EnemyTracerESP
end

function ESP:_getTeamColor(player: Player)
	if player == LocalPlayer then
		return FriendlyESPColour
	end

	if not player.Team or not LocalPlayer.Team then
		return NeutralESPColour
	end

	if player.Team == LocalPlayer.Team then
		return FriendlyESPColour
	end

	return EnemyESPColour
end

function ESP:_getHealthColor(health, maxHealth)
	if not health or not maxHealth or maxHealth <= 0 then
		return HighHP
	end

	const percentage = health / maxHealth

	if percentage > 0.65 then
		return HighHP
	elseif percentage > 0.25 then
		return MediumHP
	end

	return LowHP
end

function ESP:_getCharacterBounds(character)
	const cframe, size = character:GetBoundingBox()
	const halfSize = size * 0.5

	const corners = {
		Vector3.new(-halfSize.X, -halfSize.Y, -halfSize.Z),
		Vector3.new(-halfSize.X, -halfSize.Y, halfSize.Z),
		Vector3.new(-halfSize.X, halfSize.Y, -halfSize.Z),
		Vector3.new(-halfSize.X, halfSize.Y, halfSize.Z),

		Vector3.new(halfSize.X, -halfSize.Y, -halfSize.Z),
		Vector3.new(halfSize.X, -halfSize.Y, halfSize.Z),
		Vector3.new(halfSize.X, halfSize.Y, -halfSize.Z),
		Vector3.new(halfSize.X, halfSize.Y, halfSize.Z),
	}

	local minX = math.huge
	local minY = math.huge

	local maxX = -math.huge
	local maxY = -math.huge

	local hasFrontPoint = false

	for _, corner in corners do
		const worldPosition = cframe:PointToWorldSpace(corner)
		const screenPosition = Camera:WorldToViewportPoint(worldPosition)

		if screenPosition.Z > 0 then
			hasFrontPoint = true

			minX = math.min(minX, screenPosition.X)
			minY = math.min(minY, screenPosition.Y)

			maxX = math.max(maxX, screenPosition.X)
			maxY = math.max(maxY, screenPosition.Y)
		end
	end

	if not hasFrontPoint then
		return nil
	end

	return Vector2.new(
		minX,
		minY
	), Vector2.new(
		maxX - minX,
		maxY - minY
	)
end

function ESP:createBoxESP(player: Player)
	const box = Drawing.new("Square")

	box.Visible = false
	box.Color = ESP:_getTeamColor(player)
	box.Thickness = 2
	box.Filled = false
	box.ZIndex = 1

	return box
end

function ESP:createNameTag(player: Player)
	const nameTag = Drawing.new("Text")

	nameTag.Visible = false
	nameTag.Color = ESP:_getTeamColor(player)
	nameTag.Size = 16
	nameTag.Center = true
	nameTag.Outline = true
	nameTag.OutlineColor = Color3.new(0, 0, 0)
	nameTag.Font = 2
	nameTag.Text = player.Name
	nameTag.ZIndex = 3

	return nameTag
end

function ESP:createHealthBar(player: Player)
	const healthBar = Drawing.new("Square")

	healthBar.Visible = false
	healthBar.Color = HighHP
	healthBar.Thickness = 1
	healthBar.Filled = true
	healthBar.ZIndex = 2

	return healthBar
end

function ESP:createHealthBarBackground(player: Player)
	const background = Drawing.new("Square")

	background.Visible = false
	background.Color = Color3.new(0, 0, 0)
	background.Thickness = 1
	background.Filled = true
	background.ZIndex = 1

	return background
end

function ESP:createTracer(player: Player)
	const tracer = Drawing.new("Line")

	tracer.Visible = false
	tracer.Color = ESP:_getTeamColor(player)
	tracer.Thickness = 1
	tracer.ZIndex = 1

	return tracer
end

function ESP:_hidePlayer(player: Player)
	const data = ESPObjects[player]

	if not data then
		return
	end

	data.Box.Visible = false
	data.NameTag.Visible = false
	data.HealthBar.Visible = false
	data.HealthBarBackground.Visible = false
	data.Tracer.Visible = false
end

function ESP:_removePlayer(player: Player)
	const trove = PlayerTroves[player]

	if trove then
		trove:Destroy()
	end

	PlayerTroves[player] = nil
	ESPObjects[player] = nil
end

function ESP:_addPlayer(player: Player)
	if ESPObjects[player] then
		return
	end

	const trove = MainTrove:Extend()

	const box = ESP:createBoxESP(player)
	const nameTag = ESP:createNameTag(player)
	const healthBar = ESP:createHealthBar(player)
	const healthBarBackground = ESP:createHealthBarBackground(player)
	const tracer = ESP:createTracer(player)

	ESPObjects[player] = {
		Box = box,
		NameTag = nameTag,
		HealthBar = healthBar,
		HealthBarBackground = healthBarBackground,
		Tracer = tracer,
	}

	PlayerTroves[player] = trove

	trove:Add(function()
		box:Remove()
	end)

	trove:Add(function()
		nameTag:Remove()
	end)

	trove:Add(function()
		healthBar:Remove()
	end)

	trove:Add(function()
		healthBarBackground:Remove()
	end)

	trove:Add(function()
		tracer:Remove()
	end)

	trove:Add(player.CharacterRemoving:Connect(function()
		ESP:_hidePlayer(player)
	end))
end

function ESP:updatePlayer(player: Player)
	const data = ESPObjects[player]

	if not data then
		return
	end

	const character = player.Character

	if not character then
		ESP:_hidePlayer(player)
		return
	end

	const humanoid = character:FindFirstChildOfClass("Humanoid")
	const rootPart = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not rootPart then
		ESP:_hidePlayer(player)
		return
	end

	if humanoid.Health <= 0 then
		ESP:_hidePlayer(player)
		return
	end

	const distance = (
		Camera.CFrame.Position
		- rootPart.Position
	).Magnitude

	if distance > ViewESPDistance then
		ESP:_hidePlayer(player)
		return
	end

	const rootScreenPosition, rootVisible =
		Camera:WorldToViewportPoint(rootPart.Position)

	if rootScreenPosition.Z <= 0 then
		ESP:_hidePlayer(player)
		return
	end

	const boxPosition, boxSize =
		ESP:_getCharacterBounds(character)

	if not boxPosition or not boxSize then
		ESP:_hidePlayer(player)
		return
	end

	if boxSize.X <= 0 or boxSize.Y <= 0 then
		ESP:_hidePlayer(player)
		return
	end

	const viewportSize = Camera.ViewportSize

	if
		boxPosition.X + boxSize.X < 0
		or boxPosition.Y + boxSize.Y < 0
		or boxPosition.X > viewportSize.X
		or boxPosition.Y > viewportSize.Y
	then
		ESP:_hidePlayer(player)
		return
	end

	const espColour = ESP:_getTeamColor(player)

	data.Box.Position = boxPosition
	data.Box.Size = boxSize
	data.Box.Color = espColour
	data.Box.Visible = ESP:_shouldShowBox(player)

	data.NameTag.Text = player.Name

	data.NameTag.Position = Vector2.new(
		boxPosition.X + boxSize.X * 0.5,
		boxPosition.Y - 18
	)

	data.NameTag.Color = espColour
	data.NameTag.Visible = ESP:_shouldShowName(player)

	const healthPercentage = math.clamp(
		humanoid.Health / humanoid.MaxHealth,
		0,
		1
	)

	const healthBarWidth = 4
	const healthBarGap = 4

	data.HealthBarBackground.Position = Vector2.new(
		boxPosition.X - healthBarGap - healthBarWidth,
		boxPosition.Y
	)

	data.HealthBarBackground.Size = Vector2.new(
		healthBarWidth,
		boxSize.Y
	)

	data.HealthBarBackground.Visible =
		ESP:_shouldShowHealthBar(player)

	const healthHeight =
		boxSize.Y * healthPercentage

	data.HealthBar.Position = Vector2.new(
		boxPosition.X - healthBarGap - healthBarWidth + 1,
		boxPosition.Y + boxSize.Y - healthHeight + 1
	)

	data.HealthBar.Size = Vector2.new(
		healthBarWidth - 2,
		math.max(healthHeight - 2, 0)
	)

	data.HealthBar.Color =
		ESP:_getHealthColor(
			humanoid.Health,
			humanoid.MaxHealth
		)

	data.HealthBar.Visible =
		ESP:_shouldShowHealthBar(player)
		and healthHeight > 2

	data.Tracer.From = Vector2.new(
		viewportSize.X * 0.5,
		viewportSize.Y
	)

	data.Tracer.To = Vector2.new(
		boxPosition.X + boxSize.X * 0.5,
		boxPosition.Y + boxSize.Y
	)

	data.Tracer.Color = espColour

	data.Tracer.Visible =
		ESP:_shouldShowTracer(player)
		and rootVisible
end

function ESP:updateAllESP()
	if not Running then
		return
	end

	for player in ESPObjects do
		ESP:updatePlayer(player)
	end
end

function ESP:_onPlayerAdded(player: Player)
	if not Running then
		return
	end

	ESP:_addPlayer(player)
end

function ESP:_onPlayerRemoving(player: Player)
	ESP:_removePlayer(player)
end

function ESP:SetViewESPDistance(distance: number)
	ViewESPDistance = math.max(distance, 0)
end

function ESP:GetViewESPDistance()
	return ViewESPDistance
end

function ESP:SetEnemyBoxESP()
	EnemyBoxESP = not EnemyBoxESP
end

function ESP:SetEnemyNameESP()
	EnemyNameESP = not EnemyNameESP
end

function ESP:SetEnemyHealthBarESP()
	EnemyHealthBarESP = not EnemyHealthBarESP
end

function ESP:SetEnemyTracerESP()
	EnemyTracerESP = not EnemyTracerESP
end

function ESP:SetTeamBoxESP()
	TeamBoxESP = not TeamBoxESP
end

function ESP:SetTeamNameESP()
	TeamNameESP = not TeamNameESP
end

function ESP:SetTeamHealthBarESP()
	TeamHealthBarESP = not TeamHealthBarESP
end

function ESP:SetTeamTracerESP()
	TeamTracerESP = not TeamTracerESP
end

function ESP:SetSelfBoxESP()
	SelfBoxESP = not SelfBoxESP
end

function ESP:SetSelfNameESP()
	SelfNameESP = not SelfNameESP
end

function ESP:SetSelfHealthBarESP()
	SelfHealthBarESP = not SelfHealthBarESP
end

function ESP:SetSelfTracerESP()
	SelfTracerESP = not SelfTracerESP
end

function ESP:Start()
	if Running then
		return
	end

	Running = true

	for _, player in PlayerService:GetPlayers() do
		ESP:_addPlayer(player)
	end

	MainTrove:Add(
		PlayerService.PlayerAdded:Connect(function(player)
			ESP:_onPlayerAdded(player)
		end)
	)

	MainTrove:Add(
		PlayerService.PlayerRemoving:Connect(function(player)
			ESP:_onPlayerRemoving(player)
		end)
	)

	MainTrove:Add(
		RunService.RenderStepped:Connect(function()
			ESP:updateAllESP()
		end)
	)
end

function ESP:Stop()
	if not Running then
		return
	end

	Running = false

	for player in ESPObjects do
		ESP:_hidePlayer(player)
	end
end

function ESP:Cleanup()
	Running = false

	MainTrove:Clean()

	PlayerTroves = {}
	ESPObjects = {}

	MainTrove = Trove.new()
end

return ESP
